# Server Configuration
NODE_ENV=production
PORT=3000

# Security & Authentication
# Required for admin portal authentication (/api/admin). Set to a secure random string in production.
ADMIN_PASSWORD=your-secure-admin-password-here

# Optional ARG gate password for public verification (/api/verify). Defaults to '0408-1998-XXXX'.
AUTH_PASSWORD=0408-1998-XXXX

# Upstash Redis Database Configuration
# Set these variables using Fly.io secrets: `fly secrets set UPSTASH_REDIS_URL="your-redis-url"`
UPSTASH_REDIS_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Alternative Vercel KV Environment Variable Names (Supported automatically)
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here

# Site Configuration & Features (Optional)
STOREFRONT_URL=#
MAINTENANCE_MODE=false
STUDIO_MAINTENANCE_MODE=false
MLTK_MAINTENANCE_MODE=false
EMERGENCY_LOCKDOWN=false
